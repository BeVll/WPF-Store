<Window x:Class="StoreWpf.CreateProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoreWpf"
        mc:Ignorable="d"
        Title="CreateProductWindow" Height="350" Width="200">
    <Grid>

        <StackPanel Margin="30" >
            <TextBox x:Name="BarcodeTextBox" HorizontalAlignment="Left"   Margin="0,10,0,0" TextWrapping="Wrap" Text="Штрих-код" VerticalAlignment="Top"  PreviewTextInput="NumberValidationTextBox" Width="120"/>
            <TextBox x:Name="TitleTextBox" HorizontalAlignment="Left"  Margin="0,10,0,0" TextWrapping="Wrap" Text="Назва товару" VerticalAlignment="Center" Width="120"></TextBox>
            <TextBox x:Name="PriceTextBox" HorizontalAlignment="Left"  Margin="0,10,0,0" TextWrapping="Wrap" Text="Ціна"  PreviewTextInput="NumberValidationTextBox" VerticalAlignment="Center" Width="120"></TextBox>
            <TextBox x:Name="DescriptionTextBox" HorizontalAlignment="Left" Margin="0,10,0,0" MinLines="5"  TextWrapping="Wrap" Text="Опис" VerticalAlignment="Center" Width="120"></TextBox>
            <RadioButton x:Name="IsDigitalRadioButton" Content="Цифровий" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Center"/>
            <RadioButton x:Name="IsPhysicalRadioButton" Content="Фізичний" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Center"/>
            <Button Content="Створити продукт" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" Click="Button_Click"/>

        </StackPanel>

    </Grid>
</Window>
